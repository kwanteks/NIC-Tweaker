<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kwanteks.NicTweaker.Controls.TweakRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="28"
    Margin="0,2,0,2">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            FontSize="12"
            FontFamily="Segoe UI Variable"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Text="{x:Bind Item.Label, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Item.TooltipText, Mode=OneWay}"
            Opacity="{x:Bind Item.EditorOpacity, Mode=OneWay}" />

        <!-- SelectedItem only — binding Text+SelectedItem TwoWay to the same property stack-overflows on refresh -->
        <ComboBox
            x:Name="ValueCombo"
            Grid.Column="1"
            MinHeight="26"
            MaxHeight="28"
            FontSize="12"
            Padding="6,2,6,2"
            Width="170"
            HorizontalAlignment="Left"
            Background="{ThemeResource TweakerInputBgBrush}"
            BorderBrush="{ThemeResource TweakerBorderBrush}"
            BorderThickness="1"
            ItemsSource="{x:Bind Item.OptionDisplays, Mode=OneWay}"
            SelectedItem="{x:Bind Item.SelectedDisplay, Mode=TwoWay}"
            Text="{x:Bind Item.SelectedDisplay, Mode=OneWay}"
            IsEditable="{x:Bind Item.AllowFreeText, Mode=OneWay}"
            IsEnabled="{x:Bind Item.IsEditorEnabled, Mode=OneWay}"
            TextSubmitted="ValueCombo_TextSubmitted"
            AutomationProperties.Name="{x:Bind Item.Label, Mode=OneWay}" />
    </Grid>
</UserControl>
