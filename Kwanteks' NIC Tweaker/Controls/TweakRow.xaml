<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kwanteks.NicTweaker.Controls.TweakRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="28"
    Margin="0,2,0,0"
    HorizontalAlignment="Stretch">

    <!-- * + fixed editor: label ellipsizes, combo never clips out of the GroupBox -->
    <Grid ColumnSpacing="6" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            FontSize="12"
            FontFamily="Segoe UI Variable"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            Text="{x:Bind Item.Label, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Item.TooltipText, Mode=OneWay}"
            Opacity="{x:Bind Item.EditorOpacity, Mode=OneWay}" />

        <ComboBox
            x:Name="ValueCombo"
            Grid.Column="1"
            Style="{StaticResource TweakerComboBoxStyle}"
            MinWidth="0"
            MaxDropDownHeight="240"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            ItemsSource="{x:Bind Item.OptionDisplays, Mode=OneWay}"
            SelectedItem="{x:Bind Item.SelectedDisplay, Mode=TwoWay}"
            Text="{x:Bind Item.SelectedDisplay, Mode=OneWay}"
            IsEditable="{x:Bind Item.AllowFreeText, Mode=OneWay}"
            IsEnabled="{x:Bind Item.IsEditorEnabled, Mode=OneWay}"
            TextSubmitted="ValueCombo_TextSubmitted"
            AutomationProperties.Name="{x:Bind Item.Label, Mode=OneWay}" />
    </Grid>
</UserControl>
