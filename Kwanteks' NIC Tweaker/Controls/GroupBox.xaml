<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kwanteks.NicTweaker.Controls.GroupBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <Grid Margin="0,0,0,10">
        <Border
            Margin="0,8,0,0"
            BorderBrush="{ThemeResource TweakerBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Background="Transparent"
            Padding="8,14,8,8">
            <ContentPresenter Content="{x:Bind ContentHost, Mode=OneWay}" />
        </Border>
        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10,0,0,0"
            Padding="6,0"
            Background="{ThemeResource TweakerWindowBgBrush}">
            <TextBlock
                Text="{x:Bind Header, Mode=OneWay}"
                FontSize="12"
                FontFamily="Segoe UI Variable"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
