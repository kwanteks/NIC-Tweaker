<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TweakerWindowBgBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TweakerInputBgBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="TweakerBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TweakerMutedTextBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TweakerAccentBrush" Color="#A78BFA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TweakerWindowBgBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="TweakerInputBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TweakerBorderBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="TweakerMutedTextBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="TweakerAccentBrush" Color="#7C3AED" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TweakerWindowBgBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TweakerInputBgBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="TweakerBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TweakerMutedTextBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TweakerAccentBrush" Color="#A78BFA" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TweakerFontSize">12</x:Double>
    <x:Double x:Key="TweakerRowHeight">28</x:Double>
    <Thickness x:Key="TweakerControlPadding">6,2,6,2</Thickness>

    <Style x:Key="TweakerComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MaxHeight" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource TweakerFontSize}" />
        <Setter Property="Padding" Value="{StaticResource TweakerControlPadding}" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource TweakerInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TweakerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="TweakerTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MaxHeight" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource TweakerFontSize}" />
        <Setter Property="Padding" Value="{StaticResource TweakerControlPadding}" />
        <Setter Property="Width" Value="170" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource TweakerInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TweakerBorderBrush}" />
    </Style>

    <Style x:Key="TweakerButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="FontSize" Value="{StaticResource TweakerFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource TweakerInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TweakerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TweakerLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TweakerFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TweakerMutedLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TweakerLabelStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TweakerMutedTextBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="TweakerCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="{StaticResource TweakerFontSize}" />
        <Setter Property="Padding" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TweakerStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TweakerWindowBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TweakerBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
</ResourceDictionary>
